# clip-report MCP — DB 접속정보 (사내 전용). 이 파일을 .env 로 복사해 값을 채우세요.
# 서버(CrfMcpServer)가 아래 위치를 순서대로 자동 로드합니다(내장):
#   1) 환경변수 CLIP_ENV_FILE 가 가리키는 파일
#   2) ~/clip-report-mcp/.env
#   3) ~/.dbtools/.env
#   4) ./.env  (서버 실행 작업폴더)
# 또는 동명의 환경변수(CLIP_DB_URL/USER/PWD)가 있으면 그게 우선.

# ---- DB 접근 토글 (기본 꺼짐) ----
# 꺼져 있으면 아래 접속정보가 있어도 DB 에 접속하지 않습니다(db_* 도구, crf_sync_fields mode=db, fields_from_db, crf_render mode=db 는 ERROR).
# CLIP_DB_READ=1      # DB 조회 허용
# CLIP_DB_WRITE=1     # 쓰기 문장(INSERT/UPDATE/DELETE/DDL) 허용 — CLIP_DB_READ=1 과 db_query allow_write=true 도 필요

CLIP_DB_URL=jdbc:tibero:thin:@<host>:<port>:<sid>
CLIP_DB_USER=<DB_USER>
CLIP_DB_PWD=<DB_PASSWORD>

# ---- crf_render (실제 엔진 PDF 출력, 선택) ----
# 리포트 **서버** 웹앱 폴더: 그 안의 WEB-INF/lib/ClipReport5.*.jar 와 WEB-INF/clipreport5/clipreport5.properties·License.properties 를 쓴다.
# CLIP_RENDER_WEBAPP=C:/path/to/clipreport5/src/main/webapp
# 폴더 구조가 다르면 따로: CLIP_RENDER_LIB=<jar 폴더>  CLIP_RENDER_PROPS=<clipreport5.properties>
# 추가 jar(JDBC 드라이버 등): CLIP_RENDER_CP=<jar 또는 폴더/*>   mode=db 의 연결 이름: CLIP_RENDER_DBNAME=<DataConnection.properties 의 dbname>
# 시간 제한(초, 기본 120): CLIP_RENDER_TIMEOUT=120
